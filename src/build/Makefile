# Build rule for target.
clang-format-src_sm.h: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 clang-format-src_sm.h
.PHONY : clang-format-src_sm.h

# fast build rule for target.
clang-format-src_sm.h/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/clang-format-src_sm.h.dir/build.make CMakeFiles/clang-format-src_sm.h.dir/build
.PHONY : clang-format-src_sm.h/fast

