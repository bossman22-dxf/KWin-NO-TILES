kscreen: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 kscreen
.PHONY : kscreen

# fast build rule for target.
kscreen/fast:
	$(MAKE) $(MAKESILENT) -f src/plugins/kscreen/CMakeFiles/kscreen.dir/build.make src/plugins/kscreen/CMakeFiles/kscreen.dir/build
.PHONY : kscreen/fast

