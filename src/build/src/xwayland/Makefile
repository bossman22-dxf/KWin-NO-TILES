	cd /home/ty/kwin/src/build && $(MAKE) $(MAKESILENT) -f src/xwayland/CMakeFiles/KWinXwaylandServerModule.dir/build.make src/xwayland/CMakeFiles/KWinXwaylandServerModule.dir/xwaylandlauncher.cpp.i
.PHONY : xwaylandlauncher.cpp.i

