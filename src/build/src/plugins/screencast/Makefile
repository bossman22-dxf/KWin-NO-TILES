# target to preprocess a source file
windowscreencastsource.cpp.i:
	cd /home/ty/kwin/src/build && $(MAKE) $(MAKESILENT) -f src/plugins/screencast/CMakeFiles/screencast.dir/build.make src/plugins/screencast/CMakeFiles/screencast.dir/windowscreencastsource.cpp.i
.PHONY : windowscreencastsource.cpp.i

windowscreencastsource.s: windowscreencastsource.cpp.s
.PHONY : windowscreencastsource.s

# target to generate assembly for a file
windowscreencastsource.cpp.s:
	cd /home/ty/kwin/src/build && $(MAKE) $(MAKESILENT) -f src/plugins/screencast/CMakeFiles/screencast.dir/build.make src/plugins/screencast/CMakeFiles/screencast.dir/windowscreencastsource.cpp.s
.PHONY : windowscreencastsource.cpp.s

