	@echo "... main.s"
	@echo "... monitor.o"
	@echo "... monitor.i"
	@echo "... monitor.s"
	@echo "... screenpreviewwidget.o"
	@echo "... screenpreviewwidget.i"
	@echo "... screenpreviewwidget.s"
	@echo "... touch.o"
	@echo "... touch.i"
	@echo "... touch.s"
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /home/ty/kwin/src/build && $(CMAKE_COMMAND) -P /home/ty/kwin/src/build/CMakeFiles/VerifyGlobs.cmake
	cd /home/ty/kwin/src/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

